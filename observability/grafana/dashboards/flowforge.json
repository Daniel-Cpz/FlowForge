        "w": 12
      },
      "targets": [
        {
          "legendFormat": "{{status}}{{outcome}}{{reason}}{{instance}}",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(flowforge_job_attempt_duration_seconds_bucket[1m])))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Attempt duration quantile 0.99",
      "datasource": {
        "uid": "flowforge-prometheus",
