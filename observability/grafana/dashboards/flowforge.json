        "w": 12
      },
      "targets": [
        {
          "legendFormat": "{{status}}{{outcome}}{{reason}}{{instance}}",
          "expr": "flowforge_snapshot_up",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Attempt duration quantile 0.5",
      "datasource": {
        "uid": "flowforge-prometheus",
