{
	admin off
	auto_https off
}
:8080 {
	handle /_gateway/health {
		respond "ok" 200
	}
	handle /metrics* {
		respond "not found" 404
	}
	handle /api/* {
		reverse_proxy api:8080
	}
	handle /ready {
		reverse_proxy api:8080
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
