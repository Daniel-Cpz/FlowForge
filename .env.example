FLOWFORGE_ENV=development
FLOWFORGE_HTTP_ADDR=:8080
FLOWFORGE_POSTGRES_HOST=localhost
FLOWFORGE_POSTGRES_PORT=5432
FLOWFORGE_POSTGRES_USER=flowforge
FLOWFORGE_POSTGRES_PASSWORD=replace-with-local-development-password
FLOWFORGE_POSTGRES_DB=flowforge
FLOWFORGE_POSTGRES_SSLMODE=disable
FLOWFORGE_REDIS_ADDR=localhost:6379
FLOWFORGE_REDIS_PASSWORD=
FLOWFORGE_REDIS_DB=0
FLOWFORGE_REDIS_STREAM=flowforge:jobs:v1
FLOWFORGE_WORKER_CONCURRENCY=1
FLOWFORGE_WORKER_CAPABILITIES=
FLOWFORGE_LEASE_SECONDS=15
FLOWFORGE_RENEW_SECONDS=5
FLOWFORGE_HEARTBEAT_SECONDS=2
FLOWFORGE_OFFLINE_SECONDS=10
FLOWFORGE_RECOVERY_SECONDS=1
FLOWFORGE_LOG_LEVEL=INFO
# Optional Docker host ports; container-to-container ports remain unchanged.
FLOWFORGE_POSTGRES_PUBLISHED_PORT=5432
FLOWFORGE_REDIS_PUBLISHED_PORT=6379
FLOWFORGE_API_PUBLISHED_PORT=8080
FLOWFORGE_DASHBOARD_PUBLISHED_PORT=5173
# Exact browser Origin allowlist; same-origin and non-browser clients also allowed.
FLOWFORGE_WS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Equal jitter: base/2..base initially; capped exponential growth.
FLOWFORGE_RETRY_BASE_SECONDS=1
FLOWFORGE_RETRY_MAX_SECONDS=30

# Phase 9 local/demo telemetry; never expose publicly.
FLOWFORGE_METRICS_ENABLED=true
FLOWFORGE_METRICS_ADDR=:9091
FLOWFORGE_OTEL_ENABLED=false
FLOWFORGE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
FLOWFORGE_OTEL_SAMPLE_RATIO=1
FLOWFORGE_PROMETHEUS_PUBLISHED_PORT=9090
FLOWFORGE_GRAFANA_PUBLISHED_PORT=3000